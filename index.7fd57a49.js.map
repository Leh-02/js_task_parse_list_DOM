"use strict";
// write code here
var employeesList = document.querySelector("ul");
function getCleanSalary(salaryFromLi) {
    return parseInt(salaryFromLi.slice(1).replaceAll(",", ""));
}
function sortList(list) {
    var employeesArray = Array.from(list.children);
    employeesArray.sort(function(a, b) {
        return getCleanSalary(b.getAttribute("data-salary")) - getCleanSalary(a.getAttribute("data-salary"));
    });
    employeesArray.forEach(function(emp) {
        return employeesList.appendChild(emp);
    });
}
function getEmployees(list) {
    var employeesArray = Array.from(list.children);
    return employeesArray.map(function(emp) {
        return {
            name: emp.textContent,
            position: emp.getAttribute("data-position"),
            salary: emp.dataset.salary,
            age: emp.dataset.age
        };
    });
}
sortList(employeesList);
getEmployees(employeesList);

